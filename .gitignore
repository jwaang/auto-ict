.env
.venv
venv/
__pycache__/
*.pyc
.pytest_cache/
# logs/* rather than logs/ — git cannot un-ignore a file inside an ignored
# directory, and the experiment store is the durable research record that must
# accumulate across sessions.
logs/*
!logs/experiments.jsonl
datasets/
historical
# Same trap as logs/ above: .claude/* rather than .claude/, so the loop
# metaprompt can be un-ignored.
.claude/*
!.claude/commands/
=0.0.27
